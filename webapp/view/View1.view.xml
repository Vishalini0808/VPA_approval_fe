<mvc:View
    controllerName="vpaapproval.controller.View1"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    displayBlock="true">

    <Page  id="approvalDashboardPage" title="Approval Dashboard"  showNavButton="true"  navButtonPress=".onNavBack">

        <content>

            <VBox id="vboxs" width="100%"  class="sapUiSmallMargin">

             
                <Panel id="filterPanel" headerText="Filters" expandable="true"  expanded="true" class="sapUiSmallMarginBottom">

                    <content>

                        <HBox id="hbox" wrap="Wrap" alignItems="End" class="sapUiSmallMargin">

                          
                            <VBox id="vbox" class="sapUiSmallMarginEnd">

                                <Label id="referencenumberInput" text="Reference Number"/>

                                <Input id="referenceNumberInput" width="200px" placeholder="Enter Reference Number"/>

                            </VBox>


                            <VBox id="Vbox" class="sapUiSmallMarginEnd">

                                <Label id="submitteremail"  text="Submitter Email"/>

                                <Input  id="submitterInput" width="200px" placeholder="Enter Submitter Email"/>

                            </VBox>


                         
                            <VBox id="VBox" class="sapUiSmallMarginEnd">

                                <Label id="statu" text="Status"/>

                                <Select id="statusSelect" width="160px" selectedKey="ALL">

                                    <items>

                                        <core:Item id="all" key="ALL"  text="All"/>

                                        <core:Item id="sumbitted" key="SUBMITTED" text="Submitted"/>

                                        <core:Item id="approved" key="APPROVED" text="Approved"/>

                                        <core:Item id="rejected" key="REJECTED" text="Rejected"/>

                                    </items>

                                </Select>

                            </VBox>
                            
                              <Button  id="searchButton" text="Search" icon="sap-icon://search"  type="Emphasized" press=".onSearch" class="sapUiSmallMarginEnd"/>
                              
                               <Button id="clearButton" text="Clear" icon="sap-icon://clear-filter"   press=".onClear"/>

                        </HBox>

                    </content>

                </Panel>


             
                <Toolbar id="toolbar">

                    <Title id="submission"    text="{='Submission Requests ('+${/Submissions/$count} +')'}"   level="H2"/>

                    <ToolbarSpacer id="toolspacer"/>

                    <Button id="refreshButton" text="Refresh" icon="sap-icon://refresh" type="Transparent"  press=".onRefresh"/>

                </Toolbar>


          
                <Table id="submissionTable"  width="100%"  inset="false" mode="MultiSelect" growing="true" growingThreshold="20" growingScrollToLoad="true"  noDataText="No submissions found"
                    items="{
                        path: '/Submissions'
                    }"
                    selectionChange=".onSelectionChange">

                    <columns>

                   
                        <Column id="cloumn"  width="160px">

                            <Text id="reference"   text="Reference Number"/>

                        </Column>


                        <Column id="cloumns" width="300px">

                            <Text id="comment" text="Comments"/>

                        </Column>


                     
                        <Column id="email"  width="160px">

                            <Text id="submitteremails" text="Submitter Email"/>

                        </Column>


                        <Column id="center" width="130px" hAlign="Center">

                            <Text id="status" text="Status"/>

                        </Column>

                    </columns>


                    <items>

                        <ColumnListItem id="navigation" type="Navigation"  press=".onItemPress">

                            <cells>

                             
                                <Text id="referencenumber" text="{referenceNumber}" wrapping="false"/>


                             
                                <Text id="comments" text="{comments}" wrapping="true" maxLines="2"/>


                             
                                <Text id="emails"  text="{submitterEmail}"   wrapping="false"/>


                         
                                <ObjectStatus id="objectstatus"
                                    text="{= ${status} === 'SUBMITTED' ? 'Submitted' : ${status} === 'APPROVED' ? 'Approved' : ${status} === 'REJECTED' ? 'Rejected' : ${status} }"
                                    state="{= ${status} === 'SUBMITTED' ? 'Information' : ${status} === 'APPROVED' ? 'Success' : ${status} === 'REJECTED' ? 'Error' : 'None' }"/>

                            </cells>

                        </ColumnListItem>

                    </items>

                </Table>

            </VBox>

        </content>

    </Page>

</mvc:View>