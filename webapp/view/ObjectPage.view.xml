<mvc:View
    id="objectPageView"
    controllerName="vpaapproval.controller.ObjectPage"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:uxap="sap.uxap"
    xmlns:l="sap.ui.layout"
    displayBlock="true">

    <Page
    id="objectPageContainer"
    title=""
    showNavButton="true"
    navButtonPress=".onNavBack">


    <uxap:ObjectPageLayout id="submissionObjectPage" showTitleInHeaderContent="true" showHeaderContent="true" useIconTabBar="false" upperCaseAnchorBar="false" enableLazyLoading="false">

     <uxap:headerTitle>

            <uxap:ObjectPageDynamicHeaderTitle
                id="submissionHeaderTitle">



                <uxap:expandedHeading>

                    <VBox id="expandedHeadingBox">

                        <Title
                            id="referenceNumberTitle"
                            text="{referenceNumber}"
                            level="H1"/>

                        <Text
                            id="submissionRequestText"
                            text="Submission Request"
                            class="sapUiTinyMarginTop"/>

                    </VBox>

                </uxap:expandedHeading>


    

                <uxap:snappedHeading>

                    <Title
                        id="snappedReferenceNumberTitle"
                        text="{referenceNumber}"
                        level="H2"/>

                </uxap:snappedHeading>


          
        <uxap:actions>

  
    <Button
        id="approveButton"
        text="Approve"
        icon="sap-icon://accept"
        type="Accept"
        press=".onApprove"
        visible="{= ${status} === 'SUBMITTED' }"/>


    <Button
        id="rejectButton"
        text="Reject"
        icon="sap-icon://decline"
        type="Reject"
        press=".onReject"
        visible="{= ${status} === 'SUBMITTED' }"/>

</uxap:actions>

            </uxap:ObjectPageDynamicHeaderTitle>

        </uxap:headerTitle>



        <uxap:headerContent>

            <l:Grid
                id="headerInformationGrid"
                width="100%"
                defaultSpan="L4 M6 S12"
                hSpacing="2"
                vSpacing="1">

 

                <VBox
                    id="headerStatusColumn"
                    class="sapUiSmallMarginBottom">

                    <Label
                        id="headerStatusLabel"
                        text="Status"/>

                    <ObjectStatus
                        id="headerStatus"
                        text="{= ${status} === 'SUBMITTED' ? 'Submitted' : ${status} === 'APPROVED' ? 'Approved' : ${status} === 'REJECTED' ? 'Rejected' : ${status} }"
                        state="{= ${status} === 'SUBMITTED' ? 'Information' : ${status} === 'APPROVED' ? 'Success' : ${status} === 'REJECTED' ? 'Error' : 'None' }"
                        icon="{= ${status} === 'APPROVED' ? 'sap-icon://accept' : ${status} === 'REJECTED' ? 'sap-icon://decline' : 'sap-icon://pending' }"
                        class="sapUiSmallMarginTop"/>

                </VBox>



                <VBox
                    id="headerSubmitterColumn"
                    class="sapUiSmallMarginBottom">

                    <Label
                        id="headerSubmitterLabel"
                        text="Submitter"/>

                    <Text
                        id="headerSubmitterEmail"
                        text="{submitterEmail}"
                        class="sapUiSmallMarginTop"/>

                </VBox>



                <VBox
                    id="headerReferenceNumberColumn"
                    class="sapUiSmallMarginBottom">

                    <Label
                        id="headerReferenceNumberLabel"
                        text="Reference Number"/>

                    <Text
                        id="headerReferenceNumber"
                        text="{referenceNumber}"
                        class="sapUiSmallMarginTop"/>

                </VBox>

            </l:Grid>

        </uxap:headerContent>



        <uxap:sections>


     
            <uxap:ObjectPageSection
                id="submissionDetailsSection"
                title="Submission Details">

                <uxap:subSections>

                    <uxap:ObjectPageSubSection
                        id="submissionDetailsSubSection">

                        <uxap:blocks>

                            <VBox
                                id="submissionDetailsContainer"
                                width="100%"
                                class="sapUiMediumMarginBeginEnd sapUiSmallMarginTop sapUiSmallMarginBottom">

                                <l:Grid
                                    id="submissionDetailsGrid"
                                    width="100%"
                                    defaultSpan="L3 M6 S12"
                                    hSpacing="2"
                                    vSpacing="2">



                                    <VBox
                                        id="detailsReferenceNumberColumn"
                                        class="sapUiSmallMarginBottom">

                                        <Label
                                            id="detailsReferenceNumberLabel"
                                            text="Reference Number"/>

                                        <Text
                                            id="detailsReferenceNumber"
                                            text="{referenceNumber}"
                                            class="sapUiSmallMarginTop"/>

                                    </VBox>



                                    <VBox
                                        id="detailsSubmitterColumn"
                                        class="sapUiSmallMarginBottom">

                                        <Label
                                            id="detailsSubmitterLabel"
                                            text="Submitter Email"/>

                                        <Text
                                            id="detailsSubmitterEmail"
                                            text="{submitterEmail}"
                                            class="sapUiSmallMarginTop"/>

                                    </VBox>


                        

                                    <VBox
                                        id="detailsStatusColumn"
                                        class="sapUiSmallMarginBottom">

                                        <Label
                                            id="detailsStatusLabel"
                                            text="Status"/>

                                        <ObjectStatus
                                            id="detailsStatus"
                                            text="{= ${status} === 'SUBMITTED' ? 'Submitted' : ${status} === 'APPROVED' ? 'Approved' : ${status} === 'REJECTED' ? 'Rejected' : ${status} }"
                                            state="{= ${status} === 'SUBMITTED' ? 'Information' : ${status} === 'APPROVED' ? 'Success' : ${status} === 'REJECTED' ? 'Error' : 'None' }"
                                            icon="{= ${status} === 'APPROVED' ? 'sap-icon://accept' : ${status} === 'REJECTED' ? 'sap-icon://decline' : 'sap-icon://pending' }"
                                            class="sapUiSmallMarginTop"/>

                                    </VBox>


                                    <!-- Comments -->

                                    <VBox
                                        id="detailsCommentsColumn"
                                        class="sapUiSmallMarginBottom">

                                        <Label
                                            id="detailsCommentsLabel"
                                            text="Comments"/>

                                        <Text
                                            id="detailsComments"
                                            text="{comments}"
                                            wrapping="true"
                                            width="100%"
                                            class="sapUiSmallMarginTop"/>

                                    </VBox>


                                </l:Grid>

                            </VBox>

                        </uxap:blocks>

                    </uxap:ObjectPageSubSection>

                </uxap:subSections>

            </uxap:ObjectPageSection>


   

<uxap:ObjectPageSection id="pricingResultsSection"  title="Pricing Results">

    <uxap:subSections>

        <uxap:ObjectPageSubSection  id="pricingResultsSubSection" title="Pricing Results">

            <uxap:blocks>

                <Table id="pricingResultsTable"  width="100%" growing="true" growingThreshold="10" items="{pricingResults}">

                    <headerToolbar>

                        <Toolbar id="toolbars">

                            <Title
                                id="pricingResultsTitle"
                                text="Pricing Results"/>

                        </Toolbar>

                    </headerToolbar>

                    <columns>

                        <Column id="modelColumn">
                            <Text id="model" text="Model"/>
                        </Column>

                        <Column id="orderTypeColumn">
                            <Text id="order type" text="Order Type"/>
                        </Column>

                        <Column id="regionColumn">
                            <Text id="region" text="Region"/>
                        </Column>

                        <Column id="nspColumn"  hAlign="End">
                            <Text id="nsp" text="NSP"/>
                        </Column>

                        <Column id="basicPriceColumn" hAlign="End">
                            <Text id="basicprice" text="Basic Price"/>
                        </Column>

                        <Column id="exShowroomColumn"  hAlign="End">
                            <Text id="exshowroom" text="Ex-Showroom"/>
                        </Column>

                        <Column id="insuranceColumn" hAlign="End">
                            <Text id="Insurance" text="Insurance"/>
                        </Column>

                        <Column id="onRoadColumn" hAlign="End">
                            <Text id="onroadprice" text="On-Road Price"/>
                        </Column>

                        <Column id="pricingStatusColumn">
                            <Text id="Statu" text="Status"/>
                        </Column>

                    </columns>

                    <items>

                        <ColumnListItem
                            id="pricingResultRow">

                            <cells>

                                <Text
                                    id="modelText"
                                    text="{model_modelCode}"/>

                                <Text
                                    id="orderTypeText"
                                    text="{orderType}"/>

                                <Text
                                    id="regionText"
                                    text="{region_regionCode}"/>

                                <ObjectNumber
                                    id="nspText"
                                    number="{nspPrice}"/>

                                <ObjectNumber
                                    id="basicPriceText"
                                    number="{basicPrice}"/>

                                <ObjectNumber
                                    id="exShowroomText"
                                    number="{exShowroomPrice}"/>

                                <ObjectNumber
                                    id="insuranceText"
                                    number="{totalInsurance}"/>

                                <ObjectNumber
                                    id="onRoadText"
                                    number="{onRoadPrice}"/>

                                <ObjectStatus
                                    id="pricingStatus"
                                    text="{status}"
                                    state="{= ${status} === 'APPROVED' ? 'Success' : ${status} === 'REJECTED' ? 'Error' : 'Information' }"/>

                            </cells>

                        </ColumnListItem>

                    </items>

                </Table>

            </uxap:blocks>

        </uxap:ObjectPageSubSection>

    </uxap:subSections>

</uxap:ObjectPageSection>



        </uxap:sections>

    </uxap:ObjectPageLayout>

</Page>
</mvc:View>